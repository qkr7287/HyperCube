{
	"name": "contmon",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npx esbuild src/lib/server/ws-server.ts --bundle --platform=node --outfile=build/ws-server.js --format=esm --packages=external",
		"start": "node server.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@types/three": "^0.183.1",
		"@types/ws": "^8.5.13",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^7.0.4"
	},
	"dependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@tweenjs/tween.js": "^25.0.0",
		"@types/dockerode": "^3.3.43",
		"3d-force-graph": "^1.79.1",
		"chart.js": "^4.5.0",
		"chartjs-adapter-date-fns": "^3.0.0",
		"echarts": "^5.5.0",
		"d3-force-3d": "^3.0.5",
		"dockerode": "^4.0.8",
		"html2canvas": "^1.4.1",
		"three": "^0.183.2",
		"ws": "^8.18.0"
	}
}
